# Recovr.ai Environment Configurations

# Environment mode: development / staging / production
ENVIRONMENT=development

# Server configs
PORT=8000
HOST=0.0.0.0

# Database URI (Use local or MongoDB Atlas URI)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=recovr_db

# Anthropic API credentials for LLM recovery diagnosis and messaging
ANTHROPIC_API_KEY=your-anthropic-api-key-here
